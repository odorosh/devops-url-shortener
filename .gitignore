# Системний кеш Python (створюється автоматично при запуску)
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/

# Віртуальні оточення (якщо ви створювали venv локально)
venv/
.venv/
env/

# Локальні змінні оточення (паролі, секрети бази даних)
.env

# Службові файли Fedora / Linux
.DS_Store
.directory
